<Window x:Class="InsERT.Mox.QuickInstallerCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Icon="Install.ico"
        Title="{Binding Konfiguracja.Title, Mode=OneTime}" MinHeight="350" MinWidth="650" 
		Height="450" Width="650" HorizontalAlignment="Center" VerticalAlignment="Center" 
		Background="#fafafa" FontSize="14"
		WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <RoutedUICommand x:Key="CheckAllCommand" Text="CheckAll">
            <RoutedUICommand.InputGestures>
                <KeyGesture>CTRL+A</KeyGesture>
            </RoutedUICommand.InputGestures>
        </RoutedUICommand>
        <SolidColorBrush x:Key="IconButtonForeground"  Color="#505050" />
        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="8 4" />
            <Setter Property="BorderBrush" Value="#FFABADB3" />
        </Style>
        <ControlTemplate x:Key="CloseButton" TargetType="{x:Type Button}">
            <Border x:Name="border" BorderBrush="Transparent" Background="Transparent" Padding="2">
                <Path x:Name="iks" Stretch="Fill" Height="11" Width="11" StrokeThickness="0.8" Margin="3"
                          Stroke="{DynamicResource IconButtonForeground}"
                  Data="M0,0 11,11 M11,0 0,11"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True" SourceName="border">
                    <Setter Property="Background" TargetName="border" Value="LightBlue"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="Button" x:Key="DeleteControl">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.3"/>
            <Setter Property="Template" Value="{DynamicResource CloseButton}"/>
            <Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Border}, Path=IsMouseOver}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4" />
        </Style>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{StaticResource CheckAllCommand}" CanExecute="CheckAllCommand_CanExecute" Executed="CheckAllCommand_Executed"/>
    </Window.CommandBindings>
    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4" HorizontalAlignment="Right" >
            <TextBlock Margin="10 10 50 10" Name="OdinstalujLink" >
                    <Hyperlink IsEnabled="{Binding MoznaDalej}"  Click="Odinstaluj_Click" >Odinstaluj</Hyperlink>
            </TextBlock>
            <Button Name="OdrzucamButton" Content="Nie zgadzam się" Click="Odrzucam_Click" Visibility="{Binding LicencjaVisibility}" Margin="4" />
            <Button Name="MainButton" Content="{Binding TekstKlawisza}" IsEnabled="{Binding MoznaDalej}" Click="Dalej_Click" Margin="4" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Konfiguracja.ProviderInfo, Mode=OneWay}" Margin="12 4" TextWrapping="Wrap" FontStyle="Italic" />

        <DockPanel DockPanel.Dock="Top">

            <Image Stretch="Uniform" Source="{Binding Konfiguracja.Logo, Mode=OneTime}"
				   VerticalAlignment="Top" Margin="8" MaxWidth="168" MaxHeight="168" DockPanel.Dock="Left" />

            <ScrollViewer Name="ScrollViewer" VerticalScrollBarVisibility="Auto" ScrollChanged="ScrollViewer_ScrollChanged"  DockPanel.Dock="Right">
                <StackPanel>
                    <TextBlock Name="MainTextBox" Margin="4 8" TextWrapping="Wrap" Text="{Binding Informacja, Mode=OneWay}" />

                    <StackPanel Name="Opcje" Margin="0,4,0,0">
                        <Expander Visibility="{Binding UtworzSkrotVisibility}" IsExpanded="{Binding IsExpandedUtworzSkrot, Mode=OneWay}"
                                  Background="#f3f3f3" Margin="0,0,4,0" Padding="4">
                            <Expander.Header>
                                <CheckBox Content="{Binding UtworzSkrotNaPulpicieTekst}" 
										  VerticalContentAlignment="Center"
										  IsChecked="{Binding UtworzSkrotNaPulpicie, Mode=TwoWay}" IsThreeState="True"/>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Path=ShortcutCfgCollection}" Margin="25,-4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10 4 10 10">
                                            <CheckBox IsChecked="{Binding CreateOnDesktop, Mode=TwoWay}" VerticalContentAlignment="Center" HorizontalAlignment="Center"
                                                  ToolTip="{Binding Shortcut.Opis}" >
                                                <Image Stretch="Uniform" Source="{Binding Icon, Mode=OneTime}"
												VerticalAlignment="Top" MaxWidth="48" MaxHeight="48"/>
                                            </CheckBox>
                                            <TextBlock Text="{Binding ScenarioName, Mode=OneTime}" MaxWidth="150" MinWidth="150" TextTrimming="CharacterEllipsis" FontSize="12"
                                                   ToolTip="{Binding ScenarioName}" TextAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Expander>
                        <Expander Visibility="{Binding UtworzSkrotVisibility}" IsExpanded="{Binding IsExpandedUtworzSkrot, Mode=OneWay}"
                                  Background="#f3f3f3" Margin="0,4,4,0" Padding="4">
                            <Expander.Header>
                                <CheckBox Content="{Binding UtworzSkrotWMenuStartTekst}" 
										  VerticalContentAlignment="Center"
										  IsChecked="{Binding UtworzSkrotWMenuStart}" IsThreeState="True"/>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Path=ShortcutCfgCollection}" Visibility="{Binding UtworzSkrotVisibility}" Margin="25,-4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10 4 10 10">
                                            <CheckBox IsChecked="{Binding CreateInStartMenu, Mode=TwoWay}" VerticalContentAlignment="Center" HorizontalAlignment="Center"
                                                  ToolTip="{Binding Shortcut.Opis}" >
                                                <Image Stretch="Uniform" Source="{Binding Icon, Mode=OneTime}"
												VerticalAlignment="Top" MaxWidth="48" MaxHeight="48"/>
                                            </CheckBox>
                                            <TextBlock Text="{Binding ScenarioName, Mode=OneTime}" MaxWidth="150" MinWidth="150" TextTrimming="CharacterEllipsis" FontSize="12" TextAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Expander>
                        <TextBlock Visibility="{Binding RestartInfoVisibility}" Margin="4" Text="Proszę ponownie uruchomić program nexo." 
										   Foreground="Red"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Grid DockPanel.Dock="Top" Visibility="{Binding LicencjaVisibility}" Margin="8 4 8 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label FontWeight="SemiBold">Warunki umowy</Label>
            <RichTextBox Grid.Row="1" Name="Licencja" IsReadOnly="True" Margin="4,0,4,0" VerticalScrollBarVisibility="Visible" 
						 FontSize="12"/>
            <TextBlock Grid.Row="2" Name="LicencjaInfo" TextWrapping="Wrap" Margin="4">
				Jeśli akceptujesz warunki umowy, wybierz "Zgadzam się". Musisz zaakceptować warunki umowy, aby zainstalować rozwiązanie.
            </TextBlock>
        </Grid>

        <Grid Visibility="{Binding DatabaseSelectionVisibility}" Margin="8 4 8 0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Vertical"  Grid.Row="0" >
                <TextBlock Text="{Binding Path=DatabaseSelectionDescription}" Margin="4 0 0 0"/>
                <Grid Margin="0 8 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding CheckedAll, Mode=TwoWay}" Content="Zaznacz/odznacz wszystkie" 
							      VerticalContentAlignment="Center" FontWeight="SemiBold" 
								  Grid.Column="0"/>

                    <TextBox Grid.Column="1" x:Name="DatabaseFilter" Margin="4 0" TextChanged="DatabaseFilter_TextChanged" 
								 Padding="4 2"
								 VerticalAlignment="Center"
								 VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Column="1" Margin="4 0 0 0" Foreground="#c0c0c0" Text="Filtruj" 
								   x:Name="DatabaseFilterWatermark" IsHitTestVisible="False" Padding="8 2"
								   VerticalAlignment="Center" FontSize="12"/>

                    <Button Grid.Column="2" Style="{StaticResource DeleteControl}" Margin="0 0 8 0" 
								x:Name="RemoveFilterButton" Click="RemoveFilterButton_Click" ToolTip="Usuń filtr" />
                </Grid>
            </StackPanel>

            <ScrollViewer x:Name="DatabaseList" Grid.Row="1"
						  VerticalScrollBarVisibility="Auto" Margin="0,0,0,7" >
                <ItemsControl  ItemsSource="{Binding DatabaseCollection}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#dadada" BorderThickness="0 1 0 0">
                                <CheckBox IsChecked="{Binding Path=IsChecked, Mode=TwoWay}" IsEnabled="{Binding Path=IsEnabled, Mode=OneTime}"
										      VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch">
                                    <CheckBox.Content>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding Version, Mode=OneTime}" Foreground="#606060"/>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding Path=Description, Mode=OneTime}" Margin="10 0" Foreground="#606060"/>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Path=Name, Mode=OneTime}" TextWrapping="WrapWithOverflow"/>
                                        </DockPanel>
                                    </CheckBox.Content>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Zaznacz/odznacz wszystkie" IsChecked="{Binding CheckedAll}" Command="{StaticResource CheckAllCommand}"/>
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
            </ScrollViewer>
        </Grid>

    </DockPanel>
</Window>